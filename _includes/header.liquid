<header>
  {% assign current_lang = page.lang | default: site.lang %}
  {% assign translations = site.data.translations[current_lang] | default: site.data.translations[site.lang] %}
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != '/' %}
        <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% include social.liquid %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% for p in site.pages %}
            {% assign p_lang = p.lang | default: site.lang %}
            {% if p.ref == 'about' and p_lang == current_lang %} {% assign about_title = p.title %} {% endif %}
          {% endfor %}
          {% assign about_title = about_title | default: translations.about %}

          <!-- About -->
          <li class="nav-item {% if page.ref == 'about' or page.permalink == '/' %}active{% endif %}">
            {% if current_lang == site.lang %}
              {% assign about_url = '/' %}
            {% else %}
              {% assign about_url = '/' | append: current_lang | append: '/' %}
            {% endif %}
            <a class="nav-link" href="{{ about_url | relative_url }}">
              {{- about_title }}
              {% if page.ref == 'about' or page.permalink == '/' %}
                <span class="sr-only">({{ translations.current }})</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% assign p_lang = p.lang | default: site.lang %}
            {% if p.nav and p.autogen == null and p_lang == site.lang %}
              {% assign nav_page = p %}
              {% if current_lang != site.lang and p.ref %}
                {% assign translated_matches = site.pages | where: 'ref', p.ref | where: 'lang', current_lang %}
                {% if translated_matches.size > 0 %}
                  {% assign nav_page = translated_matches | first %}
                {% endif %}
              {% endif %}
              {% if nav_page.dropdown %}
                {% assign has_active_child = false %}
                {% for child in nav_page.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == nav_page.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- nav_page.title }}
                    {% if page.title == nav_page.title or has_active_child %}
                      <span class="sr-only">({{ translations.current }})</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in nav_page.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = nav_page.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if nav_page.permalink contains '://' -%}
                    {%- assign url = nav_page.permalink -%}
                  {%- elsif nav_page.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = nav_page.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- nav_page.title }}
                    {% if page.url contains nav_page.url %}
                      <span class="sr-only">({{ translations.current }})</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="{{ translations.search }}" onclick="openSearchModal()">
                <span class="nav-link">ctrl k <i class="ti ti-search"></i></span>
              </button>
            </li>
          {% endif %}
          {% if page.ref %}
            {% assign translated_pages = site.pages | where: 'ref', page.ref | sort: 'lang' %}
            {% if translated_pages.size > 1 %}
              <li class="nav-item">
                {% for translated_page in translated_pages %}
                  {% if translated_page.lang != current_lang %}
                    <a class="nav-link" href="{{ translated_page.url | relative_url }}">{{ translated_page.lang | upcase }}</a>
                  {% endif %}
                {% endfor %}
              </li>
            {% endif %}
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="{{ translations.change_theme }}">
                <i class="ti ti-sun-moon" id="light-toggle-system"></i>
                <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
                <i class="ti ti-sun-filled" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
